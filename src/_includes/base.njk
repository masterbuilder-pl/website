<!DOCTYPE html>
<html lang="{{ language }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title or "MasterBuilder.pl" }}</title>
  
  {# --- ADD THIS ENTIRE SEO BLOCK --- #}
  <!-- Basic SEO Meta Tags -->
  <meta name="description" content="{{ description or content | striptags | truncate(155) }}">

  <!-- Open Graph Meta Tags (for social media previews) -->
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ description or content | striptags | truncate(155) }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  {# The image URL must be absolute for social media crawlers to find it #}
  <meta property="og:image" content="{{ site.url }}{{ image or '/public/logo.png' }}">
  <meta property="og:site_name" content="MasterBuilder.pl">
  <meta property="og:type" content="article">

  <!-- Twitter Card Meta Tags -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title }}">
  <meta name="twitter:description" content="{{ description or content | striptags | truncate(155) }}">
  <meta name="twitter:image" content="{{ site.url }}{{ image or '/public/logo.png' }}">
  {# --- END OF SEO BLOCK --- #}

  <link rel="stylesheet" href="/public/styles.css">
  <link rel="icon" type="image/png" href="/favicon.png">
</head>
<body>
  <header>
    <div class="header-row" style="position: relative;">
      <nav>
        <ul>
          <li>      
            <img src="/public/logo.png" alt="MasterBuilder logo" id="logo-img" width="80" height="80">
          </li>

          {% for item in site.menu %}
            <li><a href="/{{ language }}/{{ item.url }}">{{ item.label[language] }}</a></li>
          {% endfor %}
          <li>
            {% for lang in site.languages %}
              {% if lang != language %}
                <a href="/{{ lang }}/" title="{{ lang | upper }}">
                  {% if lang == "en" %}
                    <img src="/public/flags/en.png" alt="English" style="vertical-align:middle;" />
                  {% elif lang == "pl" %}
                    <img src="/public/flags/pl.png" alt="Polski" style="vertical-align:middle;" />
                  {% endif %}
                </a>
              {% endif %}
            {% endfor %}
          </li>
          <li>
             <form action="/{{ language }}/search/">
             <input type="text" name="q" placeholder="{{ translations[language].search }}...">          
             </form>
          </li>
        </ul>
      </nav>
    </div>
  </header>

  <main>
    {% block content %}
    {% endblock %}
  </main>
  <!-- Cloudflare Web Analytics -->
  <script defer src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "307001038ff84970a9335b23a8967323"}'></script>
  <!-- End Cloudflare Web Analytics -->  
  <footer>
    <p>
      &copy; MasterBuilder.pl
      
