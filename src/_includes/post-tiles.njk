{% macro post_tiles(posts) %}
<div class="masonry">
  {% for post in posts %}
    {% if loop.index == 1 %}
      {% set tileClass = "tile tall" %}
    {% elif loop.index == 4 %}
      {% set tileClass = "tile wide" %}
    {% else %}
      {% set tileClass = "tile" %}
    {% endif %}
    <a class="{{ tileClass }}" href="{{ post.url }}">
      {% if post.data.image %}
        <img src="{{ post.data.image }}" alt="{{ post.data.title }}" loading="lazy">
      {% else %}
        <div class="tile-no-image"></div>
      {% endif %}
      <div class="tile-overlay">
        <div class="tile-tags">
          {% for tag in post.data.tags %}
            {% if tag != 'post' and tag != 'news' and tag != 'moc' %}
              <span class="tag">{{ tag }}</span>
            {% endif %}
          {% endfor %}
        </div>
        <h2 class="tile-title">{{ post.data.title }}</h2>
        <time class="tile-date" datetime="{{ post.date | date }}">{{ post.date | readableDate }}</time>
        {% if post.data.rebrickable or post.data.instruction %}
          <span class="tile-cta">Get instructions →</span>
        {% endif %}
      </div>
    </a>
  {% endfor %}
</div>
{% endmacro %}
